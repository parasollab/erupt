/* MTC dashboard: a 300 x 600 world-space panel, so everything is one column and rows wrap
   their detail onto a second line instead of packing it to the right. */

.mtc-root { background-color: rgb(22, 22, 25); }

.mtc-title {
    font-size: 18px; -unity-font-style: bold; color: rgb(255, 255, 255);
    -unity-text-align: upper-center; padding-top: 8px; padding-bottom: 2px;
}
.mtc-task {
    font-size: 10px; color: rgb(125, 125, 135); -unity-text-align: upper-center;
    margin-left: 10px; margin-right: 10px; margin-bottom: 6px;
    overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}

.mtc-tabbar { flex-direction: row; margin-left: 8px; margin-right: 8px; margin-bottom: 6px; }
.mtc-tab {
    flex-grow: 1; flex-basis: 0; height: 30px; margin-left: 2px; margin-right: 2px;
    border-width: 0; border-radius: 6px;
    background-color: rgb(45, 45, 52); color: rgb(200, 200, 208);
    -unity-font-style: bold; font-size: 13px;
}
.mtc-tab--active { background-color: rgb(66, 108, 170); color: rgb(255, 255, 255); }

/* min-height: 0 lets the flex-grow lists shrink below their content height; without it the
   step list keeps its full content height and pushes the button rows out of the panel. */
.mtc-panel { flex-grow: 1; min-height: 0; overflow: hidden; padding-left: 8px; padding-right: 8px; padding-bottom: 8px; }
.mtc-title, .mtc-task, .mtc-tabbar, .mtc-section, .mtc-button-row, .mtc-status, .mtc-progress,
.mtc-field-label, .mtc-field-value, .mtc-empty { flex-shrink: 0; }

.mtc-section {
    font-size: 11px; color: rgb(150, 150, 162); -unity-font-style: bold;
    margin-top: 6px; margin-bottom: 4px; margin-left: 2px;
}
.mtc-list { background-color: rgb(30, 30, 35); border-radius: 6px; padding: 3px; min-height: 0; flex-shrink: 0; }
.mtc-list--fill { flex-grow: 1; flex-shrink: 1; }
.mtc-list .unity-scroller--vertical { width: 12px; }
.mtc-list .unity-scroller--vertical .unity-base-slider__dragger { width: 8px; left: 2px; border-radius: 4px; }
.mtc-list .unity-scroller--vertical .unity-scroller__low-button,
.mtc-list .unity-scroller--vertical .unity-scroller__high-button { display: none; }

.mtc-row {
    flex-direction: row; align-items: center;
    padding-top: 5px; padding-bottom: 5px; padding-left: 8px; padding-right: 6px;
    margin-bottom: 2px; border-radius: 5px;
    border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0);
}
.mtc-row--selected { background-color: rgb(38, 78, 44); border-left-color: rgb(120, 220, 120); }
.mtc-row--active { background-color: rgb(32, 96, 42); border-left-color: rgb(120, 220, 120); }
.mtc-row--stage-selected { background-color: rgb(38, 52, 78); border-left-color: rgb(120, 160, 255); }
.mtc-row--done { opacity: 0.6; }
.mtc-row--failed { background-color: rgb(60, 36, 34); }
.mtc-row__main { flex-grow: 1; flex-shrink: 1; }
.mtc-row__title { font-size: 12px; color: rgb(255, 255, 255); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mtc-row__detail { font-size: 10px; color: rgb(150, 150, 162); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mtc-row__comment { font-size: 10px; color: rgb(205, 190, 110); margin-top: 1px; white-space: normal; }
.mtc-row__hint { font-size: 10px; color: rgb(140, 180, 255); margin-left: 6px; flex-shrink: 0; }
.mtc-row__stats { font-size: 10px; color: rgb(160, 160, 170); margin-left: 6px; flex-shrink: 0; -unity-text-align: middle-right; }
.mtc-rank { width: 24px; flex-shrink: 0; font-size: 12px; -unity-font-style: bold; color: rgb(255, 200, 60); }
.mtc-empty { font-size: 11px; color: rgb(140, 140, 150); padding: 8px; white-space: normal; }

.mtc-button-row { flex-direction: row; margin-top: 4px; }
.mtc-button-row--last { margin-bottom: 2px; }
.mtc-button {
    flex-grow: 1; flex-basis: 0; height: 32px; margin: 2px;
    border-width: 0; border-radius: 6px;
    background-color: rgb(58, 58, 66); color: rgb(255, 255, 255);
    -unity-font-style: bold; font-size: 13px;
}
.mtc-button--primary { background-color: rgb(40, 125, 62); }
.mtc-button--danger { background-color: rgb(130, 52, 46); }
.mtc-button--record { background-color: rgb(66, 108, 170); }

.mtc-progress { margin-top: 6px; height: 18px; }
.mtc-status {
    font-size: 11px; color: rgb(190, 190, 198); -unity-text-align: upper-center;
    margin-top: 4px; white-space: normal;
}
.mtc-field-label { font-size: 11px; color: rgb(150, 150, 162); margin-top: 4px; }
.mtc-field-value { font-size: 14px; color: rgb(120, 230, 120); margin-bottom: 10px; -unity-font-style: bold; }

/* Guide highlight: blinked on and off by Factory.GuideTargetHighlight on the button to press next. */
.guide-pulse { border-width: 3px; border-color: rgb(255, 205, 60); }
