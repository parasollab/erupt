<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MTCDashboard.uss" />
    <ui:VisualElement name="mtcRoot" class="mtc-root" style="flex-grow: 1;">

        <!-- Header -->
        <ui:Label text="MTC Dashboard" name="mtcTitleLabel" class="mtc-title" />
        <ui:Label text="No task yet" name="mtcTaskIdLabel" class="mtc-task" />

        <!-- Tab bar -->
        <ui:VisualElement name="mtcTabBar" class="mtc-tabbar">
            <ui:Button text="Plan" name="mtcTabPlan" class="mtc-tab mtc-tab--active" />
            <ui:Button text="Stages" name="mtcTabStages" class="mtc-tab" />
            <ui:Button text="Solutions" name="mtcTabSolutions" class="mtc-tab" />
        </ui:VisualElement>

        <!-- Tab 1: Plan -->
        <ui:VisualElement name="mtcPanelPlan" class="mtc-panel">
            <ui:Label text="PICK &amp; PLACE RECORDING" class="mtc-section" />
            <ui:Label text="Selected object" class="mtc-field-label" />
            <ui:Label text="---" name="mtcPlanObjectIdLabel" class="mtc-field-value" />
            <ui:Label text="Select a part, start recording, then grab it and release it where it should go." name="mtcPlanHintLabel" class="mtc-empty" />
            <ui:Button text="Start Recording" name="mtcPlanRecordButton" selectable="false" focusable="false" class="mtc-button mtc-button--record" style="flex-grow: 0; margin-top: 6px; margin-bottom: 6px;" />
            <ui:Button text="Cancel Planning" name="mtcPlanCancelButton" selectable="false" focusable="false" class="mtc-button mtc-button--danger" style="flex-grow: 0;" />
            <ui:Label text="Idle" name="mtcPlanStatusLabel" class="mtc-status" />
        </ui:VisualElement>

        <!-- Tab 2: Stages -->
        <ui:VisualElement name="mtcPanelStages" class="mtc-panel" style="display: none;">
            <ui:Label text="STAGE TREE" class="mtc-section" />
            <ui:ScrollView name="mtcStageScrollView" class="mtc-list mtc-list--fill">
                <ui:VisualElement name="mtcStageTreeContainer" />
            </ui:ScrollView>
            <ui:Label text="STAGE SOLUTIONS" name="mtcStageSolutionsTitle" class="mtc-section" />
            <ui:ScrollView name="mtcStageSolutionsScrollView" class="mtc-list" style="height: 140px;">
                <ui:VisualElement name="mtcStageSolutionsContainer" />
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Tab 3: Solutions -->
        <ui:VisualElement name="mtcPanelSolutions" class="mtc-panel" style="display: none;">
            <ui:Label text="SOLUTIONS" name="mtcSolutionsTitle" class="mtc-section" />
            <ui:ScrollView name="mtcSolutionScrollView" class="mtc-list" style="height: 140px;">
                <ui:VisualElement name="mtcSolutionListContainer" />
            </ui:ScrollView>
            <ui:Label text="STEPS" name="mtcBreakdownTitle" class="mtc-section" />
            <ui:ScrollView name="mtcBreakdownScrollView" class="mtc-list mtc-list--fill">
                <ui:VisualElement name="mtcBreakdownContainer" />
            </ui:ScrollView>
            <ui:VisualElement class="mtc-button-row">
                <ui:Button text="Preview" name="mtcPreviewButton" selectable="false" focusable="false" class="mtc-button" />
                <ui:Button text="Stop" name="mtcStopPreviewButton" selectable="false" focusable="false" class="mtc-button" />
            </ui:VisualElement>
            <ui:VisualElement class="mtc-button-row mtc-button-row--last">
                <ui:Button text="Execute" name="mtcExecuteButton" selectable="false" focusable="false" class="mtc-button mtc-button--primary" />
                <ui:Button text="Cancel" name="mtcCancelExecuteButton" selectable="false" focusable="false" class="mtc-button mtc-button--danger" />
            </ui:VisualElement>
            <ui:ProgressBar title="Execution progress" value="0" low-value="0" high-value="100" name="mtcExecProgress" class="mtc-progress" style="display: none;" />
            <ui:Label text="" name="mtcExecStatusLabel" class="mtc-status" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
