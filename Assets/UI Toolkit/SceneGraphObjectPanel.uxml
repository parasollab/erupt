<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="objectPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.65); padding: 6px; flex-direction: column; overflow: hidden;">
        <ui:Label text="Selected object" name="objectPanelTitle" style="-unity-text-align: upper-center; color: rgb(255, 250, 250); -unity-font-style: bold; border-bottom-width: 2px; border-bottom-color: rgb(255, 250, 250); margin-bottom: 6px; font-size: 20px;" />
        <ui:Label text="(select an object)" name="objectPanelIdLabel" style="-unity-text-align: upper-center; color: rgb(180, 220, 255); -unity-font-style: bold; font-size: 16px; margin-bottom: 6px; white-space: normal; flex-shrink: 0;" />
        <ui:DropdownField label="Type" name="objectPanelTypeDropdown" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Toggle label="Editable" name="objectPanelEditableToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Toggle label="Carried by robot" name="objectPanelCarriedToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Label text="Attributes" style="color: rgb(255, 250, 250); -unity-font-style: bold; margin-top: 6px; margin-bottom: 2px; font-size: 14px; flex-shrink: 0;" />
        <ui:Toggle label="open" name="objectPanelOpenToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Toggle label="damage_sensitive" name="objectPanelDamageToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Toggle label="fragile" name="objectPanelFragileToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
        <ui:Toggle label="hot" name="objectPanelHotToggle" style="-unity-font-style: bold; color: rgb(255, 255, 255); font-size: 14px; margin: 2px; flex-shrink: 0;" />
    </ui:VisualElement>
</ui:UXML>
