.card {
  padding: 14px;
  margin: 10px 0;                /* remove left/right margin so it fills width */
  border-radius: 10px;
  border-width: 1px;
  border-color: rgb(70,70,70);
  background-color: rgb(35,35,35);
  min-height: 64px;
  width: 100%;                   /* fill available width */
  align-self: stretch;            /* ensure it stretches inside item container */
  position: relative;
  z-index: 0;
}

/* Card hover effect (applies to the card background instead of ListView item) */
/* .card:hover {
  background-color: rgb(50,50,50);
  border-color: rgb(110,110,110);
} */

/* Make the item container transparent and remove its padding so the card owns visuals */
.unity-list-view__item {
  padding: 0;
  background-color: rgba(0,0,0,0);
  overflow: visible;
}

.unity-collection-view__item {
  padding: 0;
  background-color: rgba(0,0,0,0);
  overflow: visible;
}

/* Disable default ListView hover/selection backgrounds */
/* .unity-list-view__item--selected,
.unity-collection-view__item--selected,
.unity-list-view__item:hover,
.unity-collection-view__item:hover {
  background-color: rgba(0,0,0,0);
} */

.card__row { flex-direction: row; align-items: center; }

.card__toggle { width: 24px; height: 24px; }
.card__spacer { width: 24px; }

.card__center { flex-grow: 1; align-items: center; overflow: visible; }
.card__title { unity-text-align: middle-center; font-size: 14px; unity-font-style: bold; color: white; position: relative; z-index: 1; }

/* Selected highlight we control from code by toggling 'is-selected' on .card */
.card.is-selected {
  border-color: rgb(130,170,255);
  background-color: rgb(45,60,85);
}

/* Add Card button hover/active visuals */
#addCardButton {
  /* Ensure default transparent bg as base */
  background-color: rgba(255,255,255,0);
  -unity-background-image-tint-color: rgb(0, 15, 255);
  border-left-color: rgba(0,0,0,0);
  border-right-color: rgba(0,0,0,0);
  border-top-color: rgba(0,0,0,0);
  border-bottom-color: rgba(0,0,0,0);
  border-left-width: 0;
  border-right-width: 0;
  border-top-width: 0;
  border-bottom-width: 0; /* will animate to simulate shadow */
  transition: background-color 0.08s ease,
              -unity-background-image-tint-color 0.08s ease,
              border-bottom-width 0.08s ease,
              border-bottom-color 0.08s ease;
}
#addCardButton:hover {
  background-color: rgba(255,255,255,0.12);
  -unity-background-image-tint-color: rgb(50, 130, 255);
  /* Faux drop shadow using a thicker bottom border */
  border-bottom-width: 6px;
  border-bottom-color: rgba(0,0,0,0.35);
}
#addCardButton:active {
  background-color: rgba(255,255,255,0.2);
  -unity-background-image-tint-color: rgb(30, 110, 235);
  /* Reduce shadow to simulate press */
  border-bottom-width: 2px;
  border-bottom-color: rgba(0,0,0,0.25);
}
