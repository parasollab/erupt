<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="instructionsPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.75); padding-top: 24px; padding-bottom: 24px; padding-left: 24px; padding-right: 24px;">
        <ui:Label text="Tutorial" name="instructionsTitleLabel" style="-unity-text-align: upper-center; color: rgb(255, 250, 250); -unity-font-style: bold; border-bottom-width: 3px; border-bottom-color: rgb(255, 250, 250); margin-bottom: 16px; font-size: 28px;" />
        <ui:Label text="Step 1 of 4" name="stepCounterLabel" style="-unity-text-align: upper-center; color: rgb(200, 200, 200); font-size: 16px; margin-bottom: 16px;" />
        <ui:Label text="Instructions go here." name="instructionsLabel" style="color: rgb(230, 230, 230); font-size: 20px; white-space: normal;" />
    </ui:VisualElement>
</ui:UXML>
