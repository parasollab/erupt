<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MTCDashboard.uss" />
    <ui:VisualElement name="doorRoot" class="mtc-root" style="flex-grow: 1;">
        <ui:Label text="Haas VF-2" name="doorTitleLabel" class="mtc-title" />
        <ui:Label text="Doors closed" name="doorStatusLabel" class="mtc-task" />
        <ui:VisualElement class="mtc-panel" style="flex-shrink: 0;">
            <ui:Label text="ENCLOSURE DOORS" class="mtc-section" />
            <ui:VisualElement class="mtc-button-row" style="flex-direction: row; flex-shrink: 0;">
                <ui:Button text="Open Doors" name="doorOpenButton" selectable="false" focusable="false" class="mtc-button mtc-button--primary" style="flex-grow: 1; margin-top: 6px; margin-bottom: 6px; margin-right: 4px; height: 48px; font-size: 18px;" />
                <ui:Button text="Close Doors" name="doorCloseButton" selectable="false" focusable="false" class="mtc-button mtc-button--danger" style="flex-grow: 1; margin-top: 6px; margin-bottom: 6px; margin-left: 4px; height: 48px; font-size: 18px;" />
            </ui:VisualElement>
            <ui:Label text="Open the doors before planning a load or unload; the robot plans around the closed doors." class="mtc-empty" />
        </ui:VisualElement>
        <ui:VisualElement class="mtc-panel" style="flex-shrink: 0; margin-top: 6px;">
            <ui:Label text="SELF-CENTRING VISE" class="mtc-section" />
            <ui:Label text="Vise open" name="viseStatusLabel" class="mtc-task" />
            <ui:Label text="" name="viseDetailLabel" class="mtc-row__detail" style="white-space: normal; margin-bottom: 4px;" />
            <ui:Label text="" name="viseDropLabel" class="mtc-row__hint" style="white-space: normal; margin-bottom: 4px;" />
            <ui:VisualElement class="mtc-button-row" style="flex-direction: row; flex-shrink: 0;">
                <ui:Button text="Clamp" name="viseClampButton" selectable="false" focusable="false" class="mtc-button mtc-button--primary" style="flex-grow: 1; margin-top: 6px; margin-bottom: 6px; margin-right: 4px; height: 48px; font-size: 18px;" />
                <ui:Button text="Release" name="viseReleaseButton" selectable="false" focusable="false" class="mtc-button mtc-button--danger" style="flex-grow: 1; margin-top: 6px; margin-bottom: 6px; margin-left: 4px; height: 48px; font-size: 18px;" />
            </ui:VisualElement>
            <ui:Label text="Set the part down between the open jaws, then Clamp: the jaws centre it and square it to the plates. Release before an unload." class="mtc-empty" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
