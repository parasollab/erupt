<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="instructionsPanel" style="margin-top: auto; margin-bottom: auto; background-color: rgba(0, 0, 0, 0.75); padding-top: 12px; padding-bottom: 12px; padding-left: 12px; padding-right: 12px;">
        <ui:Label text="Instructions" name="instructionsTitleLabel" style="-unity-text-align: upper-center; color: rgb(255, 250, 250); -unity-font-style: bold; border-bottom-width: 2px; border-bottom-color: rgb(255, 250, 250); margin-bottom: 10px; font-size: 18px;" />
        <ui:Label text="Instructions go here." name="instructionsLabel" style="color: rgb(230, 230, 230); font-size: 14px; white-space: normal;" />
    </ui:VisualElement>
</ui:UXML>
