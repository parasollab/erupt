<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="advanceConfirmPanel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.53); flex-direction: column; justify-content: center; flex-shrink: 0; visibility: visible; display: flex; opacity: 1; padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;">
        <ui:Label text="Confirm" name="advanceConfirmTitleLabel" style="-unity-text-align: upper-center; color: rgb(255, 250, 250); -unity-font-style: bold; border-bottom-width: 3px; border-bottom-color: rgb(255, 250, 250); margin-bottom: 10px; font-size: 24px;" />
        <ui:Label text="Are you sure you want to advance?" name="advanceConfirmInstructionsLabel" style="white-space: normal; -unity-text-align: upper-center; color: rgb(230, 230, 230); margin-bottom: 12px; font-size: 16px;" />
        <ui:VisualElement name="advanceConfirmButtonRow" style="flex-direction: row; justify-content: space-around; margin-bottom: 0;">
            <ui:Button text="Confirm" name="advanceConfirmButton" selectable="false" focusable="false" style="-unity-font-style: bold; margin-top: 0; flex-grow: 1;" />
            <ui:Button text="Cancel" name="advanceCancelButton" selectable="false" focusable="false" style="-unity-font-style: bold; margin-top: 0; flex-grow: 1;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
